#!/usr/bin/env bash
set -euo pipefail

out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o)
      out="$2"
      shift 2
      ;;
    -s|-S|-L)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -z "${out}" ]]; then
  echo "curl stub: -o not supplied" >&2
  exit 1
fi

cp "${CURL_FIXTURE}" "${out}"

